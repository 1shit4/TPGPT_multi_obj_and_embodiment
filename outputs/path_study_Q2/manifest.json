{
  "title": "Transported paths re-measured geometrically against a finished campaign",
  "description": "For every cell of an existing replay campaign, the grasp it actually executed is re-transported and the resulting path is measured against the scene's solid geometry -- how much of it sits inside something, how deep, and which panel -- plus a warm-started inverse-kinematics pass down the same path. No physics is stepped. Set beside the campaign's own success column, this says whether the geometric criterion separates the cells that worked from the ones that did not, which is what has to be true before it is used to select grasps.",
  "settings": {
    "varied": {
      "cell": "every row of the source campaign"
    },
    "source_rows": "outputs/expQ/rows.json",
    "fixed": {
      "source": "reshelving seed 0, one demonstration",
      "slot": "top_middle",
      "seed": 0,
      "grasp": "the candidate index the campaign recorded, from the same cached candidate set, so the grasp is identical",
      "instrument": "analytic signed distance to the scene's solid primitives; the gripper's own published surface sample placed at every transported waypoint",
      "ik_stride": 4
    }
  },

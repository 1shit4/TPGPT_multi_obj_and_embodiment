__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
outputs/**
# ...but the written-up findings are the deliverable, not scratch data, and were
# sitting untracked in an ignored directory -- exactly the provenance failure
# ROBOTICS_NOTES 7.26 is about. Keep the prose, keep the manifests that name the
# commit behind each run, and keep ignoring the bulk arrays.
#
# The first line must be `outputs/**`, not `outputs/`. Git cannot re-include a
# file whose *parent directory* is excluded -- it never descends far enough to
# read the negations -- so with `outputs/` the three `!` lines below were dead,
# and every manifest here got tracked only because someone typed `git add -f`.
# `outputs/**` excludes the contents rather than the directory, and the
# `!outputs/**/` line lets git walk back in to evaluate the file patterns.
!outputs/**/
!outputs/**/*.md
!outputs/**/manifest.json
.ipynb_checkpoints/

# The paper this project implements (arXiv:2404.13458v2). Kept on disk, not
# redistributed from this repo: the code cites it by number wherever it matters.
TPGPT.pdf

# Paper drafting workspace. Prose, figures and LaTeX live here while the paper
# is being written; nothing in it is a research artefact and none of it should
# enter the repository history until it is a submission.
paper/

# MuJoCo writes this next to the working directory on a solver warning.
MUJOCO_LOG.TXT

# Ported gripper meshes are copied verbatim from the GraspGen-X asset pack and
# regenerate from `tpgpt.grasp.port_gripper.convert`; up to 29 MB per hand.
assets/ported_grippers/*/meshes/

# Third-party YCB scans: 196 MB, re-fetchable with `python -m tpgpt.sim.ycb`.
# The generated convex decomposition in assets/ycb_mjcf IS tracked, because a
# campaign is only reproducible against the same collision geometry.
assets/ycb/
